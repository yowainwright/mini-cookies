{
  "name": "mini-cookies",
  "version": "1.0.0",
  "description": "Tiny, worry-free cookie management for browser apps.",
  "keywords": [
    "browser",
    "cookie",
    "cookie-management",
    "cookies",
    "document-cookie",
    "mini-lib",
    "secure-cookies",
    "state-management",
    "typescript"
  ],
  "homepage": "https://jeffry.in/mini-cookies/",
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/mini-cookies.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/mini-cookies.cjs",
  "module": "dist/mini-cookies.js",
  "browser": "dist/mini-cookies.umd.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/mini-cookies.umd.js",
  "jsdelivr": "dist/mini-cookies.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/mini-cookies.js",
      "import": "./dist/mini-cookies.js",
      "require": "./dist/mini-cookies.cjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "browser": "./dist/state.js",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "agent:setup": "pnpm run hooks:setup",
    "bench": "pnpm run build && node tests/e2e/bench.ts",
    "build": "pnpm run clean-dist && pnpm run build:js && pnpm run build:types",
    "build:js": "rolldown --config scripts/rolldown.config.ts",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --incremental false && node scripts/fix-dts.ts",
    "clean-dist": "rm -rf dist",
    "deps:audit": "pnpm audit --audit-level=moderate && pnpm run deps:security",
    "deps:check": "codependence",
    "deps:overrides": "pastoralist --remove-unused --summary",
    "deps:security": "pastoralist --dry-run --summary",
    "deps:update": "codependence --update",
    "deps:validate": "pnpm run deps:audit && pnpm run deps:check",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "hooks:setup": "bash scripts/agent/hooks.sh",
    "lint": "pnpm run lint:all",
    "lint:agent": "bash scripts/agent/lint.sh --agent",
    "lint:agent:all": "bash scripts/agent/lint.sh --agent --all",
    "lint:all": "bash scripts/agent/lint.sh --all",
    "lint:fix": "bash scripts/agent/lint.sh --fix --all",
    "lint:legibility": "pnpm run lint:agent",
    "lint:strict": "pnpm run lint:all",
    "prepare": "bash scripts/setup.sh --pre-commit",
    "prepublishOnly": "pnpm run validate",
    "release": "release-it",
    "setup": "bash scripts/setup.sh --agents",
    "test": "node --test tests/mini-cookies.test.ts",
    "test:e2e:prepare": "cp dist/mini-cookies.bundle.js public/ && cp dist/mini-cookies.bundle.js.map public/ && cp dist/state.bundle.js public/ && cp dist/state.bundle.js.map public/",
    "test:e2e": "pnpm test:e2e:prepare && playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "pnpm test:e2e:prepare && playwright test --config tests/playwright.config.ts --ui",
    "test:all": "pnpm test && pnpm test:e2e",
    "serve": "serve public -l 3000",
    "typecheck": "tsc --noEmit",
    "update": "pnpm run deps:update",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "codependence": "^1.0.8",
    "eslint-plugin-legibility": "^0.3.3",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pastoralist": "1.13.1",
    "release-it": "21.0.2",
    "rolldown": "1.2.5",
    "serve": "^14.2.6",
    "tslib": "2.8.1",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxfmt --write",
      "oxlint --config scripts/oxlint.config.ts --fix"
    ],
    "tests/**/*.ts": [
      "oxfmt --write",
      "oxlint --config scripts/oxlint.config.ts --fix"
    ],
    "scripts/**/*.ts": [
      "oxfmt --write",
      "oxlint --config scripts/oxlint.config.ts --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        120
      ]
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "codependence": {
    "codependencies": [
      "@commitlint/cli",
      "@commitlint/config-conventional",
      "@playwright/test",
      {
        "@types/node": "26.2.0"
      },
      {
        "codependence": "^1.0.8"
      },
      {
        "eslint-plugin-legibility": "^0.3.3"
      },
      "husky",
      "jsdom",
      "lint-staged",
      {
        "oxfmt": "^0.64.0"
      },
      {
        "oxlint": "^1.79.0"
      },
      "pastoralist",
      "release-it",
      {
        "rolldown": "1.2.5"
      },
      "serve",
      "tslib",
      "typescript"
    ],
    "files": [
      "package.json"
    ]
  },
  "pastoralist": {
    "appendix": {
      "ajv@>=7.0.0-alpha.0 <8.18.0@8.18.0": {
        "dependents": {
          "mini-cookies": "ajv@>=7.0.0-alpha.0 <8.18.0 (required by serve)"
        },
        "ledger": {
          "addedDate": "2026-08-25T00:00:00.000Z",
          "reason": "Security fix for ajv ReDoS advisory",
          "securityChecked": true,
          "securityCheckDate": "2026-08-25T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": ">=7.0.0-alpha.0 <8.18.0",
          "patchedVersion": "8.18.0"
        }
      },
      "brace-expansion@<1.1.18@1.1.18": {
        "dependents": {
          "mini-cookies": "brace-expansion@<1.1.18 (required by minimatch)"
        },
        "ledger": {
          "addedDate": "2026-08-25T00:00:00.000Z",
          "reason": "Security fix for brace-expansion DoS advisories",
          "securityChecked": true,
          "securityCheckDate": "2026-08-25T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": "<1.1.18",
          "patchedVersion": "1.1.18"
        }
      },
      "brace-expansion@>=3.0.0 <5.0.9@5.0.9": {
        "dependents": {
          "mini-cookies": "brace-expansion@>=3.0.0 <5.0.9 (required by minimatch)"
        },
        "ledger": {
          "addedDate": "2026-08-25T00:00:00.000Z",
          "reason": "Security fix for brace-expansion DoS advisories",
          "securityChecked": true,
          "securityCheckDate": "2026-08-25T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": ">=3.0.0 <5.0.9",
          "patchedVersion": "5.0.9"
        }
      },
      "ip-address@<=10.3.0@10.3.1": {
        "dependents": {
          "mini-cookies": "ip-address@<=10.3.0 (required by socks)"
        },
        "ledger": {
          "addedDate": "2026-08-25T00:00:00.000Z",
          "reason": "Security fix for ip-address SSRF/trust-boundary advisory",
          "securityChecked": true,
          "securityCheckDate": "2026-08-25T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": "<=10.3.0",
          "patchedVersion": "10.3.1"
        }
      },
      "js-yaml@>=4.0.0 <4.3.1@4.3.1": {
        "dependents": {
          "mini-cookies": "js-yaml@>=4.0.0 <4.3.1 (required by cosmiconfig)"
        },
        "ledger": {
          "addedDate": "2026-08-25T00:00:00.000Z",
          "reason": "Security fix for js-yaml quadratic CPU advisories",
          "securityChecked": true,
          "securityCheckDate": "2026-08-25T00:00:00.000Z",
          "securityProvider": "npm",
          "securityCheckResult": "clean",
          "vulnerableRange": ">=4.0.0 <4.3.1",
          "patchedVersion": "4.3.1"
        }
      }
    },
    "depPaths": [
      "package.json"
    ],
    "security": {
      "enabled": true,
      "provider": "osv",
      "severityThreshold": "medium",
      "strict": true
    },
    "checkSecurity": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    }
  }
}
