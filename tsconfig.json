{
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "src",
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "checkJs": false,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["tests", "dist"]
}
